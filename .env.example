# Copy to .env (never commit .env). Every value has a safe default.

# Database: SQLite file by default; any Postgres URL works (e.g. Supabase).
DATABASE_URL=sqlite:///./guest_inbox.db

# LLM provider: "offline" (rule-based, no key) or "gemini".
LLM_PROVIDER=offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=8

# Guards for the public "try your own message" box.
MAX_MESSAGE_CHARS=1000
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_SALT=change-me
