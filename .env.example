# Copy to .env (never commit .env). Every value has a safe default.

# Database: SQLite file by default; any Postgres URL works (e.g. Supabase).
DATABASE_URL=sqlite:///./guest_inbox.db

# LLM provider: "offline" (rule-based, no key), "gemini", or "claude" (local only: runs the
# Claude Code CLI you are signed in to on this machine; never for a public deployment).
LLM_PROVIDER=offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=8
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_BIN=claude
CLAUDE_TIMEOUT_SECONDS=45

# Guards for the public "try your own message" box.
MAX_MESSAGE_CHARS=1000
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_SALT=change-me

# The inbox assistant: AI replies per visitor per day (then the rule-based commands answer).
AGENT_LIMIT_PER_DAY=30
AGENT_TIMEOUT_SECONDS=12
